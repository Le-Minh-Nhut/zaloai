          "parameters": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              }
            },
            "required": [
              "query"
            ]
          }
        },
        {
          "name": "messaging.send",
          "description": "Send a message to a contact or a group.",
          "parameters": {
            "type": "object",
            "properties": {
              "recipient": {
                "type": "string",
                "x-one-of": [
                  "contact_id",
                  "group_id"
                ]
              },
              "contact_id": {
                "type": "string"
              },
              "group_id": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "urgent": {
                "type": "boolean"
              }
            },
            "required": [
              "body"
            ],
            "x-one-of": [
