# LifeMate configuration template. Copy to `.env` and adjust.
# Nothing here is required: `load_config()` works with zero files.

# Dataset root (contains <split>/<split>.jsonl and <split>/audio/).
LIFEMATE_DATA_ROOT=./data

# Config file used by scripts (optional).
LIFEMATE_CONFIG=configs/base.yaml

# Output locations.
LIFEMATE_OUTPUT_DIR=./outputs
LIFEMATE_CHECKPOINT_DIR=./outputs/checkpoints

# Log level for the `lifemate` logger: DEBUG | INFO | WARNING | ERROR
LIFEMATE_LOG_LEVEL=INFO

# Reproducibility.
LIFEMATE_SEED=42

# Remote logging (optional, disabled by default).
WANDB_PROJECT=lifemate
WANDB_ENTITY=
WANDB_MODE=online
